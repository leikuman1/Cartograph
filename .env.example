NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: the pipeline stores results through service-role RPCs.
SUPABASE_SECRET_KEY=
# Database tooling only. Use the Supabase session pooler connection string.
DATABASE_URL=

# Server-only model access. Set both values to enable AI.
OPENAI_API_KEY=
# Required with a key: your compatible endpoint serving OPENAI_MODEL below.
# HTTPS is required except for localhost, 127.0.0.1 or [::1].
OPENAI_BASE_URL=
# Must match the reviewed PINNED_MODEL literal in lib/ai/config.ts.
OPENAI_MODEL=workbuddy-ai/deepseek-v4.1-flash
# Optional tracing. Both the flag and key are required to enable it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cartograph
