{
  "name": "cartograph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local scripts/database.mjs migrate",
    "db:verify": "node --env-file=.env.local scripts/database.mjs verify",
    "db:advisors": "node --env-file=.env.local scripts/database.mjs advisors",
    "db:sync-organizations": "node --env-file=.env.local scripts/organizations.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.14",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.31.0"
}
